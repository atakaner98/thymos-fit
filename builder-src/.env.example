# Copy to .env.local for local dev. Values are inlined into the build.
# The anon key is public-by-design (Supabase RLS + edge-function auth protect
# the data); the user session token is what authorizes sync calls.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
